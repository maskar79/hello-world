# ===== General =====
PORT=3000
# Public URL of the site (used for Paymob callback/redirect URLs). No trailing slash.
BASE_URL=http://localhost:3000
# Set to "production" on the live server.
NODE_ENV=development

# "mock" = fake payment page for local testing. "paymob" = real payments.
PAYMENT_PROVIDER=mock

# ===== Paymob (Dashboard → Settings / Developers) =====
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (e.g. card,wallet): 1234567,7654321
PAYMOB_INTEGRATION_IDS=

# ===== Orders database =====
# Leave empty locally (orders go to data/db.json). In production use a Postgres URL, e.g. Neon:
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ===== Order confirmation email =====
# Resend (needs your own domain) or Brevo. Leave both empty to send no emails.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=إسراءيل
MAIL_REPLY_TO=
CONTACT_WHATSAPP=

# ===== Store =====
# Set to false on hosts without a persistent disk (books then live in private/books in the repo).
ALLOW_BOOK_UPLOADS=true
ADMIN_PASSWORD=change-me-to-a-long-random-password
MAX_DOWNLOADS_PER_BOOK=3
